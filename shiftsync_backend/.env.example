APP_NAME=ShiftSync
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Angular services call http://localhost:8000/api; change both if you use another port
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inout_db
DB_USERNAME=shiftsync
DB_PASSWORD=

# Jobs run inline; no queue worker or jobs table needed
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_DRIVER=file
FILESYSTEM_DISK=local
BROADCAST_DRIVER=log

# "log" writes verification/reset emails to storage/logs/laravel.log.
# Switch to smtp and fill MAIL_* to send real email.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@example.com
MAIL_FROM_NAME="${APP_NAME} Support"
